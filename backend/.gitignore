# 忽略するファイルやフォルダ

# application.properties（データベース接続情報やAPIキーを含む可能性がある）
src/main/resources/application.properties

# IntelliJ IDEA の設定ファイル
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse STS（Spring Tool Suite）の設定
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# Gradle 関連ファイル（ビルド関連ファイルなど）
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# NetBeans 関連ファイル
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Visual Studio Code の設定ファイル
.vscode/

# その他の不要なファイル（OS関連の設定ファイル等）
.DS_Store
Thumbs.db

# backend フォルダ自体は無視しない
!backend/
